# ProofPay environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── PayPal (required for real payments) ────────────────────────────────────
# Create a sandbox app at https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_SECRET=your_paypal_sandbox_secret_here
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# ── Gemini (required for real AI verification) ──────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── App settings ────────────────────────────────────────────────────────────
# Base URL for PayPal return/cancel redirects (no trailing slash)
BASE_URL=http://localhost:8000

# Set to 1 to run without Gemini API (uses deterministic keyword mock)
MOCK_AI=0

# Optional: custom SQLite path (default: proofpay.db in project root)
# DB_PATH=proofpay.db
